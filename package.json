{
  "name": "voicemotion-studio",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build:ui": "next build",
    "sync:static": "powershell -NoProfile -Command \"Copy-Item -Path out\\* -Destination static -Recurse -Force\"",
    "build:server": "cd backend && go build -o ../voicemotion.exe .",
    "build": "next build && powershell -NoProfile -Command \"Copy-Item -Path out\\* -Destination static -Recurse -Force\" && cd backend && go build -o ../voicemotion.exe .",
    "server": "./voicemotion.exe",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1162.0",
    "@aws-sdk/s3-request-presigner": "^3.1162.0",
    "@neon/config": "^1.11.2",
    "@neon/env": "^1.6.14",
    "@neon/realtime": "^0.2.0",
    "@neon/realtime-react": "^0.2.0",
    "@neondatabase/serverless": "^1.2.0",
    "next": "14.2.33",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zod": "^4.6.7",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "14.2.33",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
